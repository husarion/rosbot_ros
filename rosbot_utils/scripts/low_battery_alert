import rclpy
from rclpy.node import Node
from sensor_msgs.msg import BatteryState
import subprocess
from rclpy.qos import QoSProfile, QoSReliabilityPolicy, QoSHistoryPolicy
from ament_index_python.packages import get_package_share_directory

class LowBatteryAlert(Node):

    def __init__(self):
        super().__init__('low_battery_alert')

        qos_profile = QoSProfile(
            reliability=QoSReliabilityPolicy.BEST_EFFORT,
            history=QoSHistoryPolicy.KEEP_LAST,
            depth=10
        )

        self.subscription = self.create_subscription(
            BatteryState,
            '/battery',
            self.battery_callback,
            qos_profile
        )

        self.last_play_time = None
        self.percentage_threshold = 0.12
        self.interval_sec = 300  # 5 minutes
        self.sounds_path = get_package_share_directory('rosbot_utils') + '/config/low_battery.mp3'

    def battery_callback(self, msg: BatteryState):
        percentage = msg.percentage
        now = self.get_clock().now()

        if percentage < self.percentage_threshold:
            if self.last_play_time is None or (now - self.last_play_time).nanoseconds > self.interval_sec * 1e9:

                self.get_logger().warn(f'Low battery: {percentage*100:.1f}%')

                subprocess.Popen(['mpg123', '-q', self.sounds_path])

                self.last_play_time = now
        else:
            # reset when battery is OK again
            self.last_play_time = None


def main(args=None):
    rclpy.init(args=args)
    node = LowBatteryAlert()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
