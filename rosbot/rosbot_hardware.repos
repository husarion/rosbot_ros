    version: 5f783f89961bb16098184f5381b1a76058cec19e
  # Pin needs the twist_mux_controller `drive_controller` parameter: an older
  # revision leaves the mux unable to claim the drive controller's reference
  # interfaces and controller activation fails. Move it back only together with
  # controllers.yaml.
  husarion_controllers:
    type: git
    url: https://github.com/husarion/husarion_controllers
    version: 724f4273b637a938ffb3171ebc0e5c96d020f98d
  micro-ROS-Agent:
    type: git
    url: https://github.com/micro-ROS/micro-ROS-Agent
    version: af007872b034d1ed31de4815377031350ab0034b
  rosbot-firmware:
    type: git
    url: https://github.com/husarion/rosbot-firmware.git
    version: e86dd794d36d6c04c17598032dd5a26bb5960cdf
  tf_namespace_bridge:
    type: git
    url: https://github.com/husarion/tf_namespace_bridge
    version: 48ea8cd5184630d79ab54060e3a959881d58182c
