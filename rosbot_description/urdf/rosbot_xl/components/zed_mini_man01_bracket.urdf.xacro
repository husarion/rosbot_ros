<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="zed_mini_man01_bracket"
               params="parent_link
                       xyz:='0.0 0.0 0.0'
                       rpy:='0.0 0.0 0.0'
                       robot_namespace:=''
                       component_name:=''
                       use_tf_prefix:=False">

    <xacro:if value="${component_name == ''}">
      <xacro:property name="component_name" value="zed_mini_bracket" />
    </xacro:if>

    <xacro:property name="component_name_underscore" value="${component_name + '_' if component_name != '' else ''}" />

    <joint name="${parent_link.rstrip('_link')}_to_${component_name_underscore}joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent_link}" />
      <child link="${component_name_underscore}mount_link" />
    </joint>

    <link name="${component_name_underscore}mount_link">
      <visual>
        <geometry>
          <mesh filename="package://rosbot_description/meshes/rosbot_xl/components/zed_mini_man01_bracket.glb" />
        </geometry>
      </visual>

      <!-- Simplified collision: 4 boxes fitted to actual mesh cross-sections per
           Z-slice (verified to cover all 6582 mesh vertices) instead of the
           9k-triangle visual mesh. The bracket tapers and shifts in X as it
           rises from the narrow foot to the wide top plate. -->
      <collision>
        <origin xyz="-0.0043 0.0 -0.0143" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.0117 0.0390 0.0185" />
        </geometry>
      </collision>

      <collision>
        <origin xyz="-0.0114 0.0 0.0125" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.0257 0.0390 0.0350" />
        </geometry>
      </collision>

      <collision>
        <origin xyz="-0.0186 0.0 0.0350" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.0267 0.0390 0.0100" />
        </geometry>
      </collision>

      <collision>
        <origin xyz="-0.0210 0.0087 0.0492" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.0323 0.0681 0.0184" />
        </geometry>
      </collision>
    </link>

  </xacro:macro>
</robot>
