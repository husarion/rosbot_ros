import argparse
import os
import subprocess

CONTROLLER_MANAGER = "manipulator_controller_manager"


def run_command(cmd, timeout_sec):
    try:
        subprocess.run(cmd, check=True, timeout=timeout_sec)
    except subprocess.TimeoutExpired:
        print(f"Command timed out: {' '.join(cmd)}")
    except subprocess.CalledProcessError:
        # Mimics '|| true' in bash: ignore non-zero exit codes
        print(f"Command failed but continuing: {' '.join(cmd)}")


def main():
    parser = argparse.ArgumentParser(prog="ros2 run rosbot_controller arm_control")
    parser.add_argument("state", type=str.lower, choices=["active", "inactive"])
    parser.add_argument(
        "--namespace",
        default=os.environ.get("ROBOT_NAMESPACE", ""),
        help="Robot namespace (default: $ROBOT_NAMESPACE).",
    )
    args = parser.parse_args()

    # The ros2 CLI node lives in '/', so a relative -c would miss a namespaced manager.
    ns = args.namespace.strip("/")
    cm = f"/{ns}/{CONTROLLER_MANAGER}" if ns else f"/{CONTROLLER_MANAGER}"
    ctl = ["ros2", "control", "set_controller_state", "-c", cm]
    hw = ["ros2", "control", "set_hardware_component_state", "-c", cm]

    if args.state == "inactive":
        print("Manipulator torque will be turned off")
        run_command([*ctl, "manipulator_controller", "inactive"], 7)
        run_command([*ctl, "gripper_controller", "inactive"], 5)
        run_command([*hw, "OpenManipulatorXSystem", "inactive"], 5)
    else:
        run_command([*hw, "OpenManipulatorXSystem", "active"], 7)
        run_command([*ctl, "manipulator_controller", "active"], 5)
        run_command([*ctl, "gripper_controller", "active"], 5)


if __name__ == "__main__":
    main()
